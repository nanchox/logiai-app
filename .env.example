# Supabase → Project Settings → API (o el botón "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx   # o NEXT_PUBLIC_SUPABASE_ANON_KEY (clave anon legada)

# Solo para scripts locales (scripts/upload-seed-assets.ts). NUNCA en variables públicas ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Asistente (fase 6): solo en el servidor (Vercel). NUNCA con prefijo NEXT_PUBLIC_.
OPENROUTER_API_KEY=
# Uno o varios modelos gratuitos separados por coma; se prueban en orden si uno falla o está saturado
OPENROUTER_MODEL=openrouter/free
# Preguntas por persona y por día (por defecto 30)
CHAT_DAILY_LIMIT=30
# Opcional: otra dirección compatible con OpenRouter (pruebas o un proxy). Por defecto https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=

# Datos legales del responsable del tratamiento (Ley 1581 de 2012). Aparecen en la Política de datos; solo servidor.
LEGAL_NAME=
LEGAL_ID=          # NIT o identificación
LEGAL_ADDRESS=
LEGAL_EMAIL=       # correo para consultas y reclamos
LEGAL_PHONE=
